{
  "ruleFormatVersion": 1,
  "id": "x12.envelope.v4010",
  "kind": "envelope",
  "format": "X12",
  "version": "004010",

  "interchange": {
    "header": {
      "segmentRef": "x12.segment.ISA.v4010"
    },
    "trailer": {
      "segmentRef": "x12.segment.IEA.v4010"
    },

    "groups": {
      "minOccurs": 1,
      "maxOccurs": null,

      "header": {
        "segmentRef": "x12.segment.GS.v4010"
      },
      "trailer": {
        "segmentRef": "x12.segment.GE.v4010"
      },

      "transactions": {
        "minOccurs": 1,
        "maxOccurs": null,

        "headerTag": "ST",
        "trailerTag": "SE",

        "selection": {
          "releaseFrom": "group.header.08",
          "transactionTypeFrom": "transaction.header.01"
        },

        "structure": "resolved-transaction"
      }
    }
  },

  "customRules": [
    "X12_V4010_ENVELOPE_INTEGRITY"
  ]
}