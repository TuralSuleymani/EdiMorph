      "reference": "GS04",
      "dataElementId": "373",
      "name": "FunctionalGroupDate",
      "dataType": "DT",
      "usage": "M",
      "presence": "mandatory",
      "constraints": {
        "length": {
          "exact": 8
        },
        "allowEmpty": false,
        "lexicalFormat": "CCYYMMDD",
        "calendarDate": true
      }
    },
    "05": {
      "reference": "GS05",
      "dataElementId": "337",
      "name": "FunctionalGroupTime",
      "dataType": "TM",
      "usage": "M",
      "presence": "mandatory",
      "constraints": {
        "length": {
          "min": 4,
          "max": 8
        },
        "allowEmpty": false,
        "allowedLengths": [
          4,
          6,
          7,
          8
        ],
        "lexicalFormats": [
          "HHmm",
          "HHmmss",
          "HHmmssS",
          "HHmmssSS"
        ],
        "timeRange": {
