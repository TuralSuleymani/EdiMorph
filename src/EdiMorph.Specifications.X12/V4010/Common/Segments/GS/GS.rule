          "hourMax": 23,
          "minuteMin": 0,
          "minuteMax": 59,
          "secondMin": 0,
          "secondMax": 59,
          "fractionDigitMin": 0,
          "fractionDigitMax": 9
        },
        "timezone": "external-policy"
      }
    },
