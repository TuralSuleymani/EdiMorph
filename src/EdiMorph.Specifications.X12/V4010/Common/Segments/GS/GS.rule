          "224"
        ]
      },
      "mappingSource": "reference-guide-subset",
      "unknownMappings": "resolve-from-versioned-directory"
    },
    {
      "id": "GS-RESOLVE-VERSION",
      "type": "versionResolver",
      "agencyElement": "07",
      "versionElement": "08",
      "directoryVersion": "004010",
      "baseVersion": "004010",
      "suffixHandling": "require-explicit-implementation-convention",
      "versionMismatch": "unsupported-specification"
    },
    {
      "id": "GS-AGENCY-X12-CONTEXT",
      "type": "conditionalAllowedValues",
      "when": {
        "element": "07",
        "equals": "X"
      },
      "then": {
        "element": "08",
        "allowedValues": [
          "004010"
        ]
      },
      "configurableByPartnerImplementationConvention": true,
      "notes": "Base 004010 rule: extra suffix not accepted without an explicitly registered convention."
    },
    {
      "id": "GS-GROUP-CONTROL-UNIQUENESS",
      "type": "compositeUniqueness",
      "keyElements": [
        "01",
        "02",
        "03",
        "06"
      ],
      "window": "trading-partner-agreement",
      "ifWindowUnknown": "do-not-reject-solely-on-duplicate-during-assumed-window",
      "interpretation": "X12 RFI 1646",
      "enforcement": "contextual"
    },
    {
      "id": "GS-APPLICATION-PARTNER-ROUTING",
      "type": "partnerAgreement",
      "elements": [
        "02",
        "03"
      ],
      "requireConfiguredPair": "partner-policy",
      "compareWithISAIds": "only-if-partner-policy-requires",
      "normalization": "do-not-silently-case-fold-or-trim-for-identity"
    },
    {
      "id": "GS-BUSINESS-TIME-POLICY",
      "type": "partnerAgreement",
      "elements": [
        "04",
        "05"
      ],
      "optionalPolicies": [
        "timezone",
        "future-timestamp-tolerance",
        "clock-skew",
        "timestamp-freshness"
      ],
      "notUniversalX12Rules": true
    },
    {
      "id": "GS-BATCH-POLICY",
      "type": "partnerAgreement",
      "optionalPolicies": [
        "max-transaction-sets-per-functional-group",
        "supported-GS01-families",
        "specific-GS08-industry-conventions"
      ],
      "notUniversalX12Rules": true
    },
    {
      "id": "GS-NUMERIC-CONTROL-NUMBERS",
      "type": "numericComparisonPolicy",
      "element": "06",
      "numericValueEqualsGE02": true,
      "allowLeadingZeros": true,
      "notUniversallyRequired": [
        "monotonic-increment",
        "start-at-one",
        "fixed-nine-digit-padding"
      ]
    }
  ],
