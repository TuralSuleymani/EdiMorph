        "allowedValues": [
          "T",
          "X"
        ]
      }
    },
    "08": {
      "reference": "GS08",
      "dataElementId": "480",
      "name": "VersionReleaseIndustryIdentifierCode",
      "dataType": "AN",
      "usage": "M",
      "presence": "mandatory",
      "constraints": {
        "length": {
          "min": 1,
          "max": 12
        },
        "allowEmpty": false,
        "supportedBaseVersions": [
          "004010"
        ],
        "versionResolution": "GS07+GS08",
        "industryConventionSuffix": "partner-specification-required"
      }
    }
  },
  "rules": [
    {
      "id": "GS-EXACT-ELEMENT-COUNT",
      "type": "elementCount",
      "exact": 8
    },
    {
      "id": "GS-NO-EMPTY-REQUIRED",
      "type": "requiredElements",
      "elements": [
        "01",
        "02",
        "03",
        "04",
        "05",
        "06",
        "07",
        "08"
      ]
    },
    {
      "id": "GS-CONTEXT-ISA-GE",
      "type": "envelopeNesting",
      "mustBeInside": "ISA/IEA",
      "starts": "functional-group",
      "endsWith": "GE",
      "requiresAtLeastOne": "ST/SE",
      "allowMultipleGroupsPerInterchange": true
    },
    {
      "id": "GS-CONTROL-MATCH-GE",
      "type": "crossSegmentEquality",
      "left": {
        "segment": "GS",
        "element": "06"
      },
      "right": {
        "segment": "GE",
        "element": "02"
      },
      "comparison": "numeric-value",
      "preserveRawForDiagnostics": true
    },
    {
      "id": "GS-TRANSACTION-COUNT",
      "type": "crossSegmentCount",
      "declared": {
        "segment": "GE",
        "element": "01"
      },
      "actual": "direct-child-ST/SE-transaction-sets",
      "min": 1
    },
    {
      "id": "GS-INTERCHANGE-GROUP-COUNT",
      "type": "crossSegmentCount",
      "declared": {
        "segment": "IEA",
        "element": "01"
      },
      "actual": "direct-child-GS/GE-functional-groups"
    },
    {
      "id": "GS-TRANSACTION-CONTROLS",
      "type": "childEnvelopeIntegrity",
      "checks": [
        "ST02 equals SE02",
        "SE01 equals ST-through-SE segment count"
      ]
    },
    {
      "id": "GS-FUNCTIONAL-FAMILY",
      "type": "functionalIdentifierMapping",
      "sourceElement": "01",
      "childSegment": "ST",
      "childElement": "01",
