<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>X12 004010 rule documents, syntax handlers, and the typed 204 transaction.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EdiMorph.Abstractions\EdiMorph.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\*.rule" Exclude="$(BaseIntermediateOutputPath)**\*;$(BaseOutputPath)**\*;bin\**\*;obj\**\*">
      <LogicalName>$([System.String]::Copy('%(RelativeDir)%(Filename)%(Extension)').Replace('\','/'))</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
