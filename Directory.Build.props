<Project>

  <PropertyGroup>
    <Version>0.2.0</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Tural Suleymani, suleymani.2ral@gmail.com</Authors>
    <RepositoryUrl>https://github.com/TuralSuleymani/EdiMorph</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/TuralSuleymani/EdiMorph</PackageProjectUrl>
    <PackageTags>edi;x12</PackageTags>
    <Description>Extensible .NET library for schema-driven EDI parsing, validation, and version-scoped mapping.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
